# Namma Kart Environment Variables Example

# Backend Database (MySQL)
DB_URL=jdbc:mysql://localhost:3306/nammakart_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Backend Security
JWT_SECRET=NammaKartSecretKeyForJWTAuthTokenGeneration2026SecureKeyMustBeLongEnough

# Frontend API URL
VITE_API_URL=http://localhost:8080/api
